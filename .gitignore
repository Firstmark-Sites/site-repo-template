# Site code under git (Firstmark Site Care).
# Rule of thumb: our code and anything a hacker would plant is tracked;
# WordPress core, media, caches and third-party plugin folders are not.
# A new file anywhere that is not ignored here shows up as drift.

# WordPress core (checked separately against wordpress.org checksums)
/wp-admin/
/wp-includes/
/index.php
/license.txt
/wp-activate.php
/wp-blog-header.php
/wp-comments-post.php
/wp-config-sample.php
/wp-cron.php
/wp-links-opml.php
/wp-load.php
/wp-login.php
/wp-mail.php
/wp-settings.php
/wp-signup.php
/wp-trackback.php
/xmlrpc.php

# Secrets stay on the server
/wp-config.php

# Third-party plugins: listed with versions in plugins.lock, not stored.
# Single-file plugins in plugins/ itself stay tracked.
/wp-content/plugins/*/

# Media: only PHP inside uploads is tracked (it should not be there)
/wp-content/uploads/**
!/wp-content/uploads/**/
!/wp-content/uploads/**/*.php
!/wp-content/uploads/**/*.phtml
!/wp-content/uploads/**/*.phar

# Generated by WordPress or plugins
/wp-content/languages/
/wp-content/upgrade/
/wp-content/upgrade-temp-backup/
/wp-content/cache/
/wp-content/litespeed/
/wp-content/aiowps_backups/
/wp-content/wp-cache-config.php
/wp-content/.litespeed_conf.dat
*.log
error_log
